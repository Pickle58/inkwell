# Copied/created by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Polar sandbox checkout link (Next.js)
# Create at https://sandbox.polar.sh → Products → Checkout Links
NEXT_PUBLIC_POLAR_CHECKOUT_LINK=

# Set on the Convex deployment (not Next.js):
# npx convex env set OPENAI_API_KEY sk-...
# npx convex env set SITE_URL http://localhost:3000
# npx convex env set POLAR_WEBHOOK_SECRET <secret-from-polar-sandbox-webhook>
#
# Polar sandbox dashboard setup (https://sandbox.polar.sh):
# 1. Create org + $19/mo subscription product (with free trial)
# 2. Create a Checkout Link for that product → set NEXT_PUBLIC_POLAR_CHECKOUT_LINK
# 3. Settings → Preferences → Embedding: add localhost:3000
# 4. Settings → Webhooks: endpoint https://<deployment>.convex.site/polar/webhook
#    Events: subscription.created, subscription.updated, subscription.active,
#            subscription.canceled, subscription.uncanceled, subscription.revoked,
#            subscription.past_due
# 5. Copy webhook signing secret → npx convex env set POLAR_WEBHOOK_SECRET ...
